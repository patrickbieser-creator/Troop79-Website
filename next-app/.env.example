# Copy to .env.local and fill in.
#
# LOCAL DEV (Supabase CLI):
#   1. From next-app/, run: npm run supabase:start
#   2. The CLI prints API URL + anon key + service_role key. Paste them here.
#
# CLOUD:
#   1. Create a free project at https://supabase.com
#   2. Project Settings → API → grab URL + anon (public) + service_role (secret)
#
# NEXT_PUBLIC_ prefix exposes the var to the browser. anon key is fine to expose
# (it only allows what your RLS policies permit). NEVER expose service_role.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL of the deployed site — no trailing slash. Used to build
# absolute links: the /calendar.ics feed's own URL (for the "Add to Google
# Calendar" etc. buttons) and each event's link back to its article. Defaults
# to http://localhost:3000 if unset, which is fine for local dev only.
NEXT_PUBLIC_SITE_URL=

# Signs the stub leader-session cookie that gates /admin/* routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADER_SESSION_SECRET=

# Bunny CDN — media storage for the News CMS. Grab these from your Bunny
# dashboard: Storage → your zone (name + an FTP/API Access Key), and the
# Pull Zone hostname that serves it publicly (e.g. troop79.b-cdn.net).
# Leave unset for local dev without a Bunny account; next.config.ts and the
# upload action both no-op gracefully when these are blank.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
# Bare hostname only (no https://, no path) — found under Storage → your
# zone → FTP & API Access. Only needed if your zone's primary region isn't
# the default (Falkenstein, DE) — e.g. ny.storage.bunnycdn.com for a
# New York region zone. Defaults to storage.bunnycdn.com if unset.
BUNNY_STORAGE_HOSTNAME=
BUNNY_PULL_ZONE_HOSTNAME=

# Shared-password logins. The leader password opens the full admin workspace;
# the scout password opens scout-only drafting; the family password gates
# Event Signup, gated reading, and (until Family Identity & Passwordless Auth
# ships) /profile and /library/submit-proof. Not secrets in the usual sense —
# the family password is printed in the weekly Bugle — but still per-server
# values, never committed.
LEADER_PASSWORD=
FAMILY_PASSWORD=

# Resend — outbound email (Event Signup notifications, Library/proof-submission
# review emails, Family Identity sign-in challenges). Leave unset for local dev
# without a Resend account; lib/email.ts no-ops gracefully (status: 'skipped')
# when either of these is blank.
RESEND_API_KEY=
EMAIL_FROM=
# Optional — sets Reply-To on outbound mail. Falls back to no Reply-To header.
EMAIL_REPLY_TO=

# DEV RELAY — set this on a development box and NOWHERE ELSE.
#
# Testing the family sign-in flow needs mail to actually send: the login code
# is the one message that cannot be dry-run, and local dev runs against a
# database full of REAL family addresses. With this set, every recipient is
# rewritten to this one address and the intended recipient is preserved in the
# subject as "[test→someone@example.com]", so the whole path is exercised and
# nothing can reach a family. Leave BLANK in production.
EMAIL_REDIRECT_TO=

# Where leader notifications go (library submissions, profile updates).
# Defaults to the troop's own inbox (bsatroop79bg@gmail.com) when unset, which
# is what production wants — override it on a dev box.
TROOP_NOTIFICATION_EMAIL=

# Family Identity & Passwordless Auth (Plans/Family-Identity-Auth.md). Peppers
# login_tokens' token_hash/code_hash so a database dump alone yields no usable
# credential. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IDENTITY_TOKEN_PEPPER=
