# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-broken/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and .env.example is that opt-in. It is the template — every key present,
# every value blank — so a new checkout can see what needs configuring without
# reading the source. The blanket rule above was swallowing it, which meant
# newly added variables (the EMAIL_REDIRECT_TO dev relay, for one) were
# documented only on the machine that added them. Keep values in here EMPTY;
# the one exception is the local Supabase URL, which is a localhost default.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# one-shot import script output
/import-reports/

.vercel
